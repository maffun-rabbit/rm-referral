{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rm-referral-pt",
  "build": { "command": "node scripts/prepare-release.mjs" },
  "compatibility_date": "2026-08-21",
  "routes": [
    { "pattern": "mnp-navi.jp/pt/*", "zone_name": "mnp-navi.jp" }
  ],
  "assets": { "directory": ".deploy/pt" }
}
