{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rm-referral-pt",
  "main": "worker/index.mjs",
  "build": { "command": "node scripts/production-release-guard.mjs --wrangler" },
  "compatibility_date": "2026-08-21",
  "workers_dev": false,
  "preview_urls": true,
  "vars": { "LOCALE": "pt", "APPROVED_PROMOTION_PATHNAME": "" },
  "routes": [
    { "pattern": "mnp-navi.jp/pt/*", "zone_name": "mnp-navi.jp" }
  ],
  "assets": { "directory": ".deploy/candidate-pt", "binding": "ASSETS", "run_worker_first": ["/pt/topics/*"] }
}
