---
import JapaneseShopPage from "../../../../components/JapaneseShopPage.astro";
import { loadKantoShopPages, type LegacyShopPage } from "../../../../data/load-tokyo-shop-pages";

export function getStaticPaths() {
  return loadKantoShopPages().map((page) => ({
    params: { prefecture: page.prefectureSlug, carrier: page.carrier, slug: page.slug },
    props: { page },
  }));
}

type Props = { page: LegacyShopPage };
const { page } = Astro.props;
---

<JapaneseShopPage page={page} />
