---
import LegacyLanguagePage from "../../../../../components/LegacyLanguagePage.astro";
import { loadKoreanCoveragePages, type KoreanCoveragePage } from "../../../../../data/load-korean-pages.ts";

export function getStaticPaths() {
  return loadKoreanCoveragePages().map((page) => ({
    params: { prefecture: page.prefecture, slug: page.slug },
    props: { page },
  }));
}

type Props = { page: KoreanCoveragePage };
const { page } = Astro.props;
---
<LegacyLanguagePage locale="ko" page={page} canonicalPath={`/${page.prefecture}/coverage/${page.slug}/`} headerLinkHref={`/${page.prefecture}/`} headerLinkLabel="도쿄도 매장" />
