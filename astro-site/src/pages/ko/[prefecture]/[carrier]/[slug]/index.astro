---
import LocalizedShopPage from "../../../../../components/LocalizedShopPage.astro";
import { legacyLanguageConfig } from "../../../../../i18n/legacy";
import { loadKoreanShopPages, type KoreanShopPage } from "../../../../../data/load-korean-pages.ts";

export function getStaticPaths() {
  return loadKoreanShopPages().map((page) => ({
    params: { prefecture: page.prefecture, carrier: page.carrier, slug: page.slug },
    props: { page },
  }));
}

type Props = { page: KoreanShopPage };
const { page } = Astro.props;
const shopListLabel = legacyLanguageConfig.ko.shopListLabel(page.prefectureLabel);
---
<LocalizedShopPage locale="ko" page={page} shopListLabel={shopListLabel} />
