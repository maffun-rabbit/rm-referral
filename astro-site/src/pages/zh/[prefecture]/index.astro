---
import LegacyLanguagePage from "../../../components/LegacyLanguagePage.astro";
import { chinesePrefectureSlugs, loadChineseLegacyPage, type ChineseLegacyPage } from "../../../data/load-chinese-pages.ts";
import type { MigratedPrefectureSlug } from "../../../data/load-tokyo-shop-pages.ts";

export function getStaticPaths() {
  return chinesePrefectureSlugs.map((prefecture) => ({
    params: { prefecture },
    props: { prefecture, page: loadChineseLegacyPage(prefecture) },
  }));
}

type Props = { prefecture: MigratedPrefectureSlug; page: ChineseLegacyPage };
const { prefecture, page } = Astro.props;
---

<LegacyLanguagePage locale="zh" page={page} canonicalPath={`/${prefecture}/`} />
