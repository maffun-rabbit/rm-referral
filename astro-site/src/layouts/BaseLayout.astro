---
import SiteHeader from "../components/SiteHeader.astro";
import HomeHeader from "../components/HomeHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getAbsoluteLocaleUrl, getAlternateLinks, getLocaleAssetPath, getLocalePath, type Locale } from "../config/site";
import { getMessages } from "../i18n";

type Props = {
  title: string;
  description: string;
  canonical?: string;
  canonicalPath?: string;
  availableLocales?: readonly Locale[];
  locale?: Locale;
  robots?: string;
  headerLinkHref?: string;
  headerLinkLabel?: string;
  analytics?: boolean;
  ogType?: "website" | "article";
};

const {
  title,
  description,
  canonical,
  canonicalPath,
  availableLocales = [],
  locale = "ja",
  robots = "index, follow",
  headerLinkHref,
  headerLinkLabel,
  analytics = true,
  ogType = "article",
} = Astro.props;
const messages = getMessages(locale);
const resolvedCanonical = canonical ?? (canonicalPath ? getAbsoluteLocaleUrl(locale, canonicalPath) : undefined);
const alternateLinks = canonicalPath && availableLocales.length
  ? getAlternateLinks(canonicalPath, availableLocales)
  : [];
const useEdgeIncludes = locale === "ja" && canonicalPath?.startsWith("/guide/");
---

<!doctype html>
<html lang={messages.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="rm-layout" content="shared-v1" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {resolvedCanonical && <link rel="canonical" href={resolvedCanonical} />}
    {alternateLinks.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={messages.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {resolvedCanonical && <meta property="og:url" content={resolvedCanonical} />}
    <meta name="twitter:card" content="summary" />
    <link rel="stylesheet" href={getLocaleAssetPath(locale, "/css/style.css")} />
    {analytics && <script async src="https://www.googletagmanager.com/gtag/js?id=G-86FFC09LTE" is:inline></script>}
    {analytics && <script src={getLocaleAssetPath(locale, "/js/analytics.js")} is:inline></script>}
    <slot name="head" />
  </head>
  <body>
    {canonicalPath === '/' ? <HomeHeader locale={locale} /> : useEdgeIncludes ? <rm-include src="/_includes/ja/header.html" data-locales={availableLocales.join(',')} data-header-label={headerLinkLabel ?? messages.header.defaultLinkLabel}><SiteHeader
        locale={locale}
        homeHref={getLocalePath(locale)}
        linkHref={headerLinkHref}
        linkLabel={headerLinkLabel}
        availableLocales={availableLocales.length ? availableLocales : undefined}
      /></rm-include> : <SiteHeader
        locale={locale}
        homeHref={getLocalePath(locale)}
        linkHref={headerLinkHref}
        linkLabel={headerLinkLabel}
        availableLocales={availableLocales.length ? availableLocales : undefined}
      />}
    <slot />
    {useEdgeIncludes ? <rm-include src="/_includes/ja/footer.html"><SiteFooter locale={locale} /></rm-include> : <SiteFooter locale={locale} />}
  </body>
</html>
