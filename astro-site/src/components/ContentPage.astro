---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocalizedReplacementProgramPage from './LocalizedReplacementProgramPage.astro';
import {getLocalePath, type Locale} from '../config/site';
import {readSource,routeLocales} from '../../../scripts/page-sources.mjs';
type Props={locale:Locale;route:string};
const {locale,route}=Astro.props;
const page=readSource(locale,route);
const decode=(s:string)=>s.replaceAll('&amp;','&').replaceAll('&quot;','"').replace(/&#39;|&apos;/g,"'");
---
{route === 'guide/replacement-program' ? <LocalizedReplacementProgramPage locale={locale} /> : <BaseLayout title={decode(page.title)} description={decode(page.description)} robots={page.robots} locale={locale} canonicalPath={`/${route}${route?'/':''}`} availableLocales={routeLocales(route)} ogType={route?'article':'website'} headerLinkHref={getLocalePath(locale,'/')}>
 <Fragment slot="head"><Fragment set:html={page.styles.join('')} />{page.schemas.map(schema=><script is:inline type="application/ld+json" set:html={schema} />)}</Fragment>
 <Fragment set:html={page.mainHtml} />
 <Fragment set:html={page.scripts.join('')} />
</BaseLayout>}
