---
import type { VietnameseShopPage } from "../data/load-vietnamese-pages";
import { legacyLanguageConfig } from "../i18n/legacy";
import LocalizedShopPage from "./LocalizedShopPage.astro";

type Props = { page: VietnameseShopPage };
const { page } = Astro.props;
const shopListLabel = legacyLanguageConfig.vi.shopListLabel(page.prefectureLabel);
---

<LocalizedShopPage locale="vi" page={page} shopListLabel={shopListLabel} />
