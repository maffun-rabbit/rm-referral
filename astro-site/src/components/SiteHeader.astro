---
import type { Locale } from "../config/site";
import { getMessages } from "../i18n";

type Props = {
  locale?: Locale;
  homeHref?: string;
  linkHref?: string;
  linkLabel?: string;
};

const {
  locale = "ja",
  homeHref = "/",
  linkHref = "/guide/",
  linkLabel,
} = Astro.props;
const messages = getMessages(locale);
---

<header class="site-header">
  <a class="site-name" href={homeHref}>{messages.siteName}</a>
  <a class="header-link" href={linkHref}>{linkLabel ?? messages.header.defaultLinkLabel}</a>
</header>
