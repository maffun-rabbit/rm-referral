---
import { getLocalePath, LOCALE_CONFIG, SUPPORTED_LOCALES, type Locale } from "../config/site";
import { getMessages } from "../i18n";

type Props = {
  locale?: Locale;
  homeHref?: string;
  linkHref?: string;
  linkLabel?: string;
  availableLocales?: readonly Locale[];
};

const {
  locale = "ja",
  homeHref = "/",
  linkHref = "/guide/",
  linkLabel,
  availableLocales = SUPPORTED_LOCALES,
} = Astro.props;
const messages = getMessages(locale);
const localeLabels: Record<Locale, string> = {
  ja: "🇯🇵 日本語",
  vi: "🇻🇳 Tiếng Việt",
  en: "🇺🇸 English",
  zh: "🇨🇳 中文",
  ko: "🇰🇷 한국어",
  pt: "🇧🇷 Português",
};
const currentPrefix = LOCALE_CONFIG[locale].pathPrefix;
const currentPath = Astro.url.pathname;
const sharedPath = currentPrefix && (currentPath === currentPrefix || currentPath.startsWith(`${currentPrefix}/`))
  ? currentPath.slice(currentPrefix.length) || "/"
  : currentPath;
const languageOptions = availableLocales.map((targetLocale) => ({
  locale: targetLocale,
  label: localeLabels[targetLocale],
  href: getLocalePath(targetLocale, sharedPath),
}));
---

<header class="site-header">
  <a class="site-name" href={homeHref}>{messages.siteName}</a>
  <div class="site-header-actions">
    <a class="header-link" href={linkHref}>{linkLabel ?? messages.header.defaultLinkLabel}</a>
    <div class="lang-selector-wrap">
      <select class="lang-selector" aria-label="Language / 言語" onchange="if(this.value) location.href=this.value;">
        {languageOptions.map((option) => (
          <option value={option.href} selected={option.locale === locale}>{option.label}</option>
        ))}
      </select>
    </div>
  </div>
</header>
