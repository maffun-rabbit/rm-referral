---
import { getLocalePath, type Locale } from "../config/site";
import type { ForeignLocale } from "../i18n/legacy";
import type { LegacyLanguagePage } from "../data/load-legacy-language-pages";
import BaseLayout from "../layouts/BaseLayout.astro";

type Props = {
  locale: ForeignLocale;
  page: LegacyLanguagePage;
  canonicalPath: string;
  ogType?: "website" | "article";
  headerLinkHref?: string;
  headerLinkLabel?: string;
};
const { locale, page, canonicalPath, ogType = "article", headerLinkHref = "/guide/foreigners/", headerLinkLabel } = Astro.props;
const foreignLocales: readonly Locale[] = ["vi", "en", "zh", "ko", "pt"];
const allLocales: readonly Locale[] = ["ja", ...foreignLocales];
// Topic articles intentionally have no Japanese counterpart. Keep both the
// visible switcher and hreflang links limited to routes that actually exist.
const availableLocales = canonicalPath.startsWith("/guide/topics/") ? foreignLocales : allLocales;
---

<BaseLayout
  title={page.title}
  description={page.description}
  robots={page.robots}
  locale={locale}
  canonicalPath={canonicalPath}
  availableLocales={availableLocales}
  headerLinkHref={getLocalePath(locale, headerLinkHref)}
  headerLinkLabel={headerLinkLabel}
  ogType={ogType}
>
  <Fragment slot="head">
    {page.schemas.map((schema) => <script is:inline type="application/ld+json" set:html={schema}></script>)}
    {page.localScripts.map((src) => <script src={src} defer is:inline></script>)}
  </Fragment>
  <Fragment set:html={page.mainHtml} />
</BaseLayout>
