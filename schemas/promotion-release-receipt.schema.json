{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mnp-navi.jp/schemas/promotion-release-receipt.schema.json","title":"Promotion locale release receipt","type":"object","additionalProperties":false,
  "required":["schema","promotionId","manifestSha256","releasePlanSha256","locale","pathname","targetSha256","sitemapSha256","sitemapChanged","baselineArtifactSha256","candidateInventorySha256","worker","config","versionId","deploymentId","traffic","rollbackVersionId","deployedAt","verifiedAt","httpVerification"],
